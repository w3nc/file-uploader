<%- include('partials/header') %>
<main class="card-auth">
  <svg class="logo" width="56" height="56" viewBox="0 0 40 40" aria-hidden="true">
    <polygon points="10,20 15,11 25,11 30,20 25,29 15,29" fill="none" stroke="#0284c7" stroke-width="2.6" stroke-linejoin="round"/>
  </svg>
  <h1>Sign in</h1>
  <p class="sub">to continue to Odin Drive</p>

  <form method="post" action="/login" data-busy="Signing in…">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="field">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" value="<%= email %>" required autocomplete="email" data-rule="email">
    </div>
    <div class="field">
      <label for="password">Password</label>
      <input type="password" id="password" name="password" required autocomplete="current-password">
    </div>
    <% if (error) { %><p class="error"><%= error %></p><% } %>
    <div class="auth-actions">
      <a href="/signup">Create account</a>
      <button class="btn" type="submit">Log in</button>
    </div>
  </form>
</main>
<%- include('partials/footer') %>
